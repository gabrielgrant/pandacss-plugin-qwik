{
  "compilerOptions": {
    "allowJs": true,
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "es2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "@qwik.dev/core",
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "styled-system/*": [
        "./styled-system/*"
      ],
      "~/*": [
        "./src/*"
      ],
      "styled-system-minimal/*": [
        "./styled-system-minimal/*"
      ],
      "styled-system-none/*": [
        "./styled-system-none/*"
      ]
    }
  },
  "include": [
    "src",
    "panda.config.ts",
    "vite.config.ts"
  ]
}
