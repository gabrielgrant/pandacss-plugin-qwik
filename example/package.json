{
  "name": "plugin-qwik-example",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "panda codegen && panda codegen --config panda.minimal.config.ts && panda codegen --config panda.none.config.ts",
    "prepare": "npm run codegen",
    "dev": "vite --mode ssr --port 5351 --strictPort",
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --noEmit",
    "preview": "qwik build preview && vite preview --port 5352 --strictPort",
    "e2e": "node e2e/verify.mjs",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@pandacss/dev": "2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@pandacss/preset-panda": "2.5.0",
    "@pandacss/vite": "2.5.0",
    "@qwik.dev/core": "2.0.0-rc.5",
    "@qwik.dev/router": "2.0.0-rc.5",
    "@types/node": "^22.0.0",
    "pandacss-plugin-qwik": "file:..",
    "playwright-core": "1.65.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
