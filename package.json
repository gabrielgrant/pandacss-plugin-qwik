{
  "name": "pandacss-plugin-qwik",
  "version": "0.1.0",
  "description": "Panda CSS 2 plugin that generates Qwik 2 JSX artifacts (styled factory, patterns, recipe contexts, types)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@pandacss/dev": "^2.5.0"
  },
  "devDependencies": {
    "@pandacss/dev": "2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
