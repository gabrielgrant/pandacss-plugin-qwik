{
  "name": "pandacss-plugin-qwik",
  "version": "0.3.0",
  "description": "Panda CSS 2 plugin that generates Qwik 2 JSX artifacts (styled factory, patterns, recipe contexts, types)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielgrant/pandacss-plugin-qwik.git"
  },
  "keywords": [
    "pandacss",
    "panda-plugin",
    "qwik"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@pandacss/dev": "^2.5.0"
  },
  "devDependencies": {
    "@pandacss/dev": "2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@pandacss/preset-panda": "2.5.0",
    "@qwik.dev/core": "2.0.0-rc.5",
    "@types/node": "22.19.3",
    "prettier": "^3.8.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.0.18"
  }
}
